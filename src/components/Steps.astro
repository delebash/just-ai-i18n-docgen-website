---
// SPDX-License-Identifier: MIT
// The app's own welcome — 1 Point · 2 Translate · 3 Review (Home without a project).
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const STEPS = [
  ["Point", "Give it the path to your source locale file. It reads it and tells you what it found before anything runs.", "project-setup"],
  ["Translate", "Pick languages and press Translate. The run stages proposals for every missing or flagged key.", "translate"],
  ["Review", "Work the queue: accept what's right, fix what isn't, apply the rest. Only then are your files written.", "review"],
];
---
<section class="section">
  <div class="wrap">
    <p class="eyebrow">How it works</p>
    <h2>Three steps, in this order.</h2>
    <ol class="steps">
      {STEPS.map(([name, body, doc], i) => (
        <li class="card">
          <span class="num">{i + 1}</span>
          <h3><a href={`${base}/docs/${doc}/`}>{name}</a></h3>
          <p>{body}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .steps {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr));
  }
  .num {
    display: inline-flex;
    width: 28px;
    height: 28px;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: var(--accent-soft);
    color: var(--accent-ink);
    font-weight: 700;
    font-size: 0.9rem;
    margin-bottom: 0.6rem;
  }
  h3 a {
    color: var(--ink);
    text-decoration: none;
  }
  h3 a:hover {
    color: var(--accent-ink);
  }
</style>
